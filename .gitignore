# Rust build folder
/target

# Python virtual environments
venv/
.venv/
env/
.env/

# Generated training artifacts. Everything under /data is generated and lives
# nowhere else: data/selfplay (the live corpus), data/checkpoints (the live
# run: promoted and rejected policies, pinned binaries, logs) and data/runs/<name>
# (retired runs, checkpoints and logs only — their corpora are deleted once the
# roadmap records what they showed).
/data/

# Local Claude Code state (per-machine agent settings and permissions)
.claude/
__pycache__/

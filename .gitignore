# Rust build folder
/target

# Python virtual environments
venv/
.venv/
env/
.env/

# Generated training artifacts. Everything under /data is generated and lives
# nowhere else: data/selfplay (the live corpus), data/checkpoints (the live
# run: promoted and rejected policies, pinned binaries, logs) and data/runs/<name>
# (retired runs, checkpoints and logs only — their corpora are deleted once the
# roadmap records what they showed).
/data/

# Local Claude Code state (per-machine agent settings and permissions) — all
# but the repo's skills, which are shared guidance every agent here reads
# (.claude/skills/steward: how a PR is driven without re-running CI).
.claude/*
!.claude/skills/

# The workflow audit's SARIF report. CI writes it in the workspace before
# uploading it to the Security tab, so running that job's command locally
# leaves one behind.
zizmor.sarif
__pycache__/

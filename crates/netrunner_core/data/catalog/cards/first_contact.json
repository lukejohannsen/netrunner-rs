      "illustrators": "Mauricio Herrera",
      "position": 46,
      "quantity": 3
    },
    {
      "card_id": "wendigo",
      "flavor": null,
      "has_xlarge": false,
      "id": "06047",
      "illustrators": "Wylie Beckert",
      "position": 47,
      "quantity": 3
    },
    {
      "card_id": "crisium_grid",
      "flavor": "Mars would never have been colonized if not for the Gagarin facilities at Promontorium Agarum.",
      "has_xlarge": false,
      "id": "06048",
      "illustrators": "Camille Kuo",
      "position": 48,
      "quantity": 3
    },
    {
      "card_id": "chronos_project",
      "flavor": "The irony is that those who'd want to destroy certain memories can't afford to do so, and those who can afford it-well, they're too busy sipping on dreamwine.",
      "has_xlarge": false,
      "id": "06049",
      "illustrators": "Adam S. Doyle",
      "position": 49,
      "quantity": 3
    },
    {
      "card_id": "shattered_remains",
      "flavor": null,
      "has_xlarge": false,
      "id": "06050",
      "illustrators": "Matt Zeilinger",
      "position": 50,
      "quantity": 3
    },
    {
      "card_id": "lancelot",
      "flavor": "He who wields the sword of valor.",
      "has_xlarge": false,
      "id": "06051",
      "illustrators": "Andreas Zafiratos",
      "position": 51,
      "quantity": 3
    },
    {
      "card_id": "quetzal_free_spirit",
      "flavor": "\"Why should we be slaves to our genetic heritage?\"",
      "has_xlarge": false,
      "id": "06052",
      "illustrators": "Matt Zeilinger",
      "position": 52,
      "quantity": 3
    },
    {

  "id": "first_contact",
  "printings": [
    {
      "card_id": "iq",
      "flavor": "Created by merging the brainscans of over a hundred of the most intelligent people in Haas-Bioroid's cerebral database, its effectiveness is limited either by its lack of imagination or the imagination of the sysops who employ it.",
      "has_xlarge": false,
      "id": "06041",
      "illustrators": "Eko Puteh",
      "position": 41,
      "quantity": 3
    },
    {
      "card_id": "elizas_toybox",
      "flavor": "Eliza's Toybox is the preeminent purveyor of high-class debauchery on the moon, courtesy of its bioroid pleasure models and other exotica. Every fantasy has its price.",
      "has_xlarge": false,
      "id": "06042",
      "illustrators": "Henning Ludvigsen",
      "position": 42,
      "quantity": 3
    },
    {
      "card_id": "kitsune",
      "flavor": "There are those who believe the nine-tailed fox is an angel in disguise. And then there are those who have followed, and discovered her secret...",
      "has_xlarge": false,
      "id": "06043",
      "illustrators": "Smirtouille",
      "position": 43,
      "quantity": 3
    },
    {
      "card_id": "port_anson_grid",
      "flavor": "The port was first built as a remote location to unload and offload dangerous felons.",
      "has_xlarge": false,
      "id": "06044",
      "illustrators": "Emilio Rodríguez",
      "position": 44,
      "quantity": 3
    },
    {
      "card_id": "the_news_now_hour",
      "flavor": "\"There are reports of a terrorist threat at Starport Kaguya. The NAPD is offering a reward for anyone who can provide them with information about the current whereabouts of the individual pictured here. He is considered extremely dangerous and is armed with a PAD and a portable rig.\"",
      "has_xlarge": false,
      "id": "06045",
      "illustrators": "Ed Mattinian",
      "position": 45,
      "quantity": 3
    },
    {
      "card_id": "manhunt",
      "flavor": null,

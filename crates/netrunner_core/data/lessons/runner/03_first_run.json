    {
      "prose": "Spend a click to run Archives.",
      "allow": {
        "Server": {
          "kind": "InitiateRun",
          "server": "Archives"
        }
      },
      "advance_when": {
        "Server": {
          "kind": "RunInitiated",
          "server": "Archives"
        }
      },
      "solution": [
        {
          "InitiateRun": {
            "server": "Archives"
          }
        }
      ],
      "hint": "Choose Run Archives."
    },
    {
      "prose": "No ice protects Archives, so the approach-ice and encounter phases are skipped. Continue: you move straight to the server.",
      "allow": {
        "AnyOf": [
          {
            "Kind": "ContinueRun"
          },
          {
            "Kind": "PassPriority"
          }
        ]
      },
      "advance_when": {
        "Server": {
          "kind": "ServerApproached",
          "server": "Archives"
        }
      },
      "solution": [
        "ContinueRun",
        {
          "PassPriority": {
            "side": "Runner"
          }
        }
      ],
      "hint": "Choose Continue run."
    },
    {
      "prose": "You are at the server. This is your last chance to jack out; instead, complete the run — it becomes successful and you breach the server.",
      "allow": {
        "AnyOf": [
          {
            "Kind": "CompleteRun"
          },
          {
            "Kind": "PassPriority"
          }
        ]
      },
      "advance_when": {
        "Server": {
          "kind": "RunSucceeded",
          "server": "Archives"
        }
      },
      "solution": [
